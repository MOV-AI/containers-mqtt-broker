<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Example credentials for the File RBAC extension. NOT installed in the image.
  Mount your own file at
  /opt/hivemq/extensions/hivemq-file-rbac-extension/conf/credentials.xml
  and replace every password hash (see README, "Authentication").

  Topics follow VDA 5050: <interface>/<version>/<manufacturer>/<serialNumber>/<topic>,
  for example mov.ai/v3/acme/robot-1/state.
-->
<file-rbac>
    <users>
        <user>
            <!-- The fleet-side service that talks to every robot -->
            <name>device-adapter</name>
            <!-- hash of "change-me" -->
            <password>d1hQU3R5ZzlRN2hzOHVvUnFaYVY1blVXZDVQNjZiMnM=:100:Iuhhu/HH0U0lSL2FjybmBm/SPSX9+83Lagy+8o9EAzdlekmqZzlCPgaBrdGFYXAAXGRIBVen/2LE74YEck3yag==</password>
            <roles>
                <id>fleet</id>
            </roles>
        </user>
        <user>
            <!-- One user per robot; the name is the robot's serial number -->
            <name>robot-1</name>
            <!-- hash of "change-me" -->
            <password>d1hQU3R5ZzlRN2hzOHVvUnFaYVY1blVXZDVQNjZiMnM=:100:Iuhhu/HH0U0lSL2FjybmBm/SPSX9+83Lagy+8o9EAzdlekmqZzlCPgaBrdGFYXAAXGRIBVen/2LE74YEck3yag==</password>
            <roles>
                <id>robot</id>
            </roles>
        </user>
    </users>
    <roles>
        <role>
            <id>fleet</id>
            <permissions>
                <permission>
                    <!-- Publish and subscribe on every robot topic -->
                    <topic>mov.ai/#</topic>
                </permission>
            </permissions>
        </role>
        <role>
            <id>robot</id>
            <permissions>
                <permission>
                    <!-- Publish and subscribe only below its own serial number -->
                    <topic>mov.ai/+/+/${{username}}/#</topic>
                </permission>
            </permissions>
        </role>
    </roles>
</file-rbac>
